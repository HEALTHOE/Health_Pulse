# Copy this file to .env and fill in REAL values. Never commit .env.
# backend/.env  (this file is only an example with placeholders)

# PostgreSQL connection (psycopg2 driver)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/healthpulse

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: comma-separated list, no spaces needed. Default is Vite dev server.
CORS_ORIGINS=http://localhost:5173

# App environment: dev | test | prod
APP_ENV=dev

# Default admin user created by the seed script (NOT hardcoded in code).
# Change these before running the seed in any shared/demo environment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
